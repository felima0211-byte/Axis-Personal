# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-only, never expose to browser

# Auth
OWNER_EMAIL=your@email.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Encryption (Parte B)
ENCRYPTION_KEYS={"1":"base64-encoded-32-bytes"}
ENCRYPTION_ACTIVE_VERSION=1
BLIND_INDEX_KEY=base64-encoded-32-bytes

# AI / Ingestão (Fatia 5)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
INGEST_DAILY_LIMIT=50
APP_TIMEZONE=America/Sao_Paulo
